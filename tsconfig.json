{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "target": "ES2022",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": false,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "scripts/content/validate-frontmatter.mts",
    "scripts/content/toc.mts",
    "scripts/content/sort-content.mts",
    "scripts/content/reading-time.mts",
    "scripts/content/generate-related-content.mts",
    "scripts/content/create-content.mts",
    "scripts/content/check-slugs.mts",
    "scripts/content/check-duplicates.mts"
  ],
  "exclude": ["node_modules"]
}