import fs from 'node:fs'
import path from 'node:path'
import { registerHooks } from 'node:module'
import { fileURLToPath, pathToFileURL } from 'node:url'
import matter from 'gray-matter'
import { isPublished } from '../../lib/content/status.ts'
import { readText, walkFiles, writeJson } from './toolkit.mts'

/**
 * Builds the production route inventory consumed by `lib/routing/content-path-guard.ts`.
 *
 * Why a build-time inventory exists at all
 * ----------------------------------------
 * `proxy.ts` is the only place that can reject an unknown dynamic URL before the
 * response body starts streaming, which is the only way to keep a real HTTP 404
 * on those routes (see docs/website-improvement/step-17n-*.md). The proxy runs on
 * the Node.js runtime, but it cannot read `content/` from disk in a deployed
 * build: `outputFileTracingIncludes` reaches page/server bundles only, never the
 * proxy bundle. Reading MDX there would pass on `next start` and 404 every
 * content page in a traced deployment.
 *
 * So the inventory is derived from the same content modules the pages use and
 * emitted as JSON at build time. It is generated, never hand-maintained: every
 * dynamic segment under `app/` must be resolvable here, or the build fails.
 */

export interface RouteInventory {
  $comment: string
  /** Rewrite target used to render a real 404; read by lib/routing/content-path-guard.ts. */
  unmatchedPath: string
  staticPaths: string[]
  dynamicRoutes: Array<{ pattern: string; paths: string[] }>
}

export const INVENTORY_PATH = 'lib/routing/route-inventory.generated.json'

/** A path that no route matches, used to render the real 404 document. */
export const UNMATCHED_CONTENT_PATH = '/__unmatched-content-path'

const INVENTORY_COMMENT =
  'Generated by scripts/build/generate-route-inventory.mts (run through pnpm build:prepare). Do not edit by hand — change the content or the generator instead.'

/**
 * Node strips type syntax from these TypeScript modules but cannot elide named
 * imports that only name types, and it does not resolve `@/` aliases or
 * extensionless relative specifiers. These hooks let the generator import the
 * content modules exactly as the app does, instead of re-implementing their
 * data. Modules with no runtime exports are replaced by a stub that exports the
 * names they declare, so type-only imports link instead of throwing.
 */
let loaderRegistered = false

function registerContentModuleLoader(): void {
  if (loaderRegistered) return
  loaderRegistered = true

  const root = process.cwd()
  const resolved = new Map<string, string | null>()
  const stubs = new Map<string, string | null>()

  function resolveFile(base: string): string | null {
    if (resolved.has(base)) return resolved.get(base) ?? null
    let found: string | null = null
    for (const candidate of [base, `${base}.ts`, `${base}.tsx`, `${base}.mts`, path.join(base, 'index.ts')]) {
      try {
        if (fs.statSync(candidate).isFile()) {
          found = candidate
          break
        }
      } catch {
        // keep trying the next candidate
      }
    }
    resolved.set(base, found)
    return found
  }

  function runtimeStubFor(file: string): string | null {
    if (stubs.has(file)) return stubs.get(file)!
    const source = fs.readFileSync(file, 'utf8')
    const hasRuntimeExport = /^\s*export\s+(const|let|var|function|class|enum|default)\b/m.test(source)
    const declared = [...source.matchAll(/^\s*export\s+(?:declare\s+)?(?:interface|type|enum|class)\s+(\w+)/gm)].map(
      (match) => match[1],
    )
    const stub = hasRuntimeExport
      ? null
      : `data:text/javascript,${encodeURIComponent(declared.map((name) => `export const ${name} = undefined;`).join(''))}`
    stubs.set(file, stub)
    return stub
  }

  registerHooks({
    resolve(specifier, context, nextResolve) {
      let found: string | null = null
      if (specifier.startsWith('@/')) {
        found = resolveFile(path.join(root, specifier.slice(2)))
      } else if ((specifier.startsWith('./') || specifier.startsWith('../')) && context.parentURL?.startsWith('file:')) {
        found = resolveFile(path.resolve(path.dirname(fileURLToPath(context.parentURL)), specifier))
      }

      if (!found) return nextResolve(specifier, context)
      if (/\.(ts|mts)$/.test(found)) {
        const stub = runtimeStubFor(found)
        if (stub) return { url: stub, shortCircuit: true }
      }
      return { url: pathToFileURL(found).href, shortCircuit: true }
    },
  })
}

function routePatternFromPage(file: string): string {
  const segments = file
    .replace(/^app\//, '')
    .replace(/\/page\.tsx$/, '')
    .split('/')
    .filter((segment) => segment && !segment.startsWith('('))
  return segments.length ? `/${segments.join('/')}` : '/'
}

function isDynamicPattern(pattern: string): boolean {
  return pattern.split('/').some((segment) => segment.startsWith('['))
}

interface MdxEntry {
  slug: string
  data: Record<string, unknown>
}

/** The exact shape the shared publish predicate accepts. */
type StatusFields = Parameters<typeof isPublished>[0]

function readMdxCollection(directory: string): MdxEntry[] {
  return walkFiles(directory, ['.mdx'])
    .map((relativePath) => {
      const parsed = matter(readText(relativePath))
      const slug = String(parsed.data.slug ?? path.basename(relativePath, '.mdx'))
      return { slug, data: parsed.data as Record<string, unknown> }
    })
    .filter((entry) => isPublished(entry.data as StatusFields))
}

/**
 * One enumerator per dynamic route. A dynamic segment without an entry here
 * fails the build rather than silently keeping the soft 404.
 */
async function dynamicRoutePaths(patterns: string[]): Promise<Record<string, string[]>> {
  registerContentModuleLoader()

  const [{ services, serviceFamilies }, { projects }, { publishedLocations }] = await Promise.all([
    import('@/content/services/index.ts'),
    import('@/content/work/index.ts'),
    import('@/lib/business/locations/data/index.ts'),
  ])

  const insights = readMdxCollection('content/insights')
  const caseStudies = readMdxCollection('content/case-studies')
  const problems = readMdxCollection('content/problems')
  const technologies = readMdxCollection('content/technologies')

  const enumerators: Record<string, () => string[]> = {
    '/services/[slug]': () => services.map((service: { slug: string }) => `/services/${service.slug}`),
    '/services/families/[slug]': () =>
      serviceFamilies.map((family: { slug: string }) => `/services/families/${family.slug}`),
    '/insights/[slug]': () => insights.map((entry) => `/insights/${entry.slug}`),
    '/work/[slug]': () => projects.map((project: { slug: string }) => `/work/${project.slug}`),
    '/case-studies/[slug]': () => caseStudies.map((entry) => `/case-studies/${entry.slug}`),
    '/problems/[slug]': () => problems.map((entry) => `/problems/${entry.slug}`),
    // `[category]/page.tsx` renders `technologies.getCategoryPage(slug)`, which
    // only resolves entries whose `kind` is `category` (the `<dir>/index.mdx` files).
    '/technologies/[category]': () =>
      technologies
        .filter((entry) => entry.data.kind === 'category')
        .map((entry) => `/technologies/${entry.slug}`),
    // `[category]/[slug]/page.tsx` renders `getByCategoryAndSlug(category, slug)`:
    // a tech without a `category` cannot be reached, so it is not routable.
    '/technologies/[category]/[slug]': () =>
      technologies
        .filter((entry) => (entry.data.kind ?? 'technology') === 'technology' && typeof entry.data.category === 'string')
        .map((entry) => `/technologies/${String(entry.data.category)}/${entry.slug}`),
    '/locations/[slug]': () =>
      publishedLocations.map((location: { slug: string }) => `/locations/${location.slug}`),
  }

  const unknown = patterns.filter((pattern) => !(pattern in enumerators))
  if (unknown.length) {
    throw new Error(
      `Dynamic route(s) with no inventory enumerator: ${unknown.join(', ')}. ` +
        'Add them to scripts/shared/route-inventory.mts so unknown params keep returning a real 404 in production.',
    )
  }

  const result: Record<string, string[]> = {}
  for (const pattern of patterns) result[pattern] = enumerators[pattern]()
  return result
}

export async function buildRouteInventory(): Promise<RouteInventory> {
  registerContentModuleLoader()

  const { contentProviderConfig } = await import('@/config/content.ts')

  // The enumerators below read git/MDX sources directly. Any other provider
  // would place different pages at these URLs, and the freshness check
  // re-derives from the same sources, so the mismatch would never surface as a
  // failure — only as missing or invented routes in production.
  if (contentProviderConfig.type !== 'git') {
    throw new Error(
      `CONTENT_PROVIDER="${contentProviderConfig.type}" cannot be represented by the route inventory: ` +
        'it is derived from the git/MDX sources, so a CMS-backed site would 404 its own pages or serve URLs that no longer exist. ' +
        'Set CONTENT_PROVIDER=git, or extend the enumerators in scripts/shared/route-inventory.mts for that provider.',
    )
  }

  const pagePatterns = walkFiles('app', ['.tsx'])
    .filter((file) => file.endsWith('/page.tsx') || file === 'app/page.tsx')
    .map(routePatternFromPage)

  const staticPaths = [...new Set(pagePatterns.filter((pattern) => !isDynamicPattern(pattern)))].sort()
  const dynamicPatterns = [...new Set(pagePatterns.filter(isDynamicPattern))].sort()

  if (staticPaths.includes(UNMATCHED_CONTENT_PATH)) {
    throw new Error(`${UNMATCHED_CONTENT_PATH} is reserved for not-found rewrites but a page now renders it.`)
  }

  const pathsByPattern = await dynamicRoutePaths(dynamicPatterns)
  const dynamicRoutes = dynamicPatterns.map((pattern) => ({
    pattern,
    paths: [...new Set(pathsByPattern[pattern])].sort(),
  }))

  const empty = dynamicRoutes.filter((route) => route.paths.length === 0)
  if (empty.length) {
    throw new Error(
      `Inventory is empty for ${empty.map((route) => route.pattern).join(', ')} — refusing to emit a route table that would 404 valid pages.`,
    )
  }

  return { $comment: INVENTORY_COMMENT, unmatchedPath: UNMATCHED_CONTENT_PATH, staticPaths, dynamicRoutes }
}

export async function writeRouteInventory(): Promise<RouteInventory> {
  const inventory = await buildRouteInventory()
  writeJson(INVENTORY_PATH, inventory)
  return inventory
}
